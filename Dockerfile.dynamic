# Dynamic Audio Worker Node Dockerfile (Steps 0-5 Pipeline: Whisper + Typhoon CTC + HDemucs)
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV CUDA_VISIBLE_DEVICES=0

# ติดตั้ง System Packages, FFmpeg, และ aria2 สำหรับดาวน์โหลดความเร็วสูง
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    aria2 \
    zstd \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ติดตั้งแพ็กเกจสำหรับถอดเสียงภาษาไทยและ Audio Processing Pipeline
RUN pip install --no-cache-dir \
    faster-whisper \
    transformers \
    pythainlp \
    torchaudio \
    demucs \
    fastapi \
    uvicorn \
    python-multipart \
    soundfile

# Pre-bake Audio Models (HDemucs + Whisper large-v3 + Typhoon CTC) ~7.7 GB
RUN echo "=== Pre-baking Audio Models from Cloudflare R2 ===" && \
    mkdir -p /tmp/r2_models /root/.cache && \
    cd /tmp/r2_models && \
    aria2c -x 16 -s 16 -k 10M -o models.tar.zst "https://pub-84a6cf83663a474fa4b8eb84b5ae4bd5.r2.dev/autosub-models-v1.tar.zst" && \
    tar --zstd -xf models.tar.zst -C /root/ && \
    rm -rf /tmp/r2_models && \
    mkdir -p /workspace && \
    ln -sfn /root/.cache/huggingface /workspace/.hf_home && \
    echo "=== Audio Models Pre-baked Successfully! ==="

# คัดลอกโค้ดสคริปต์, พจนานุกรม และสคริปต์ลงทะเบียนอัตโนมัติ
WORKDIR /root/whisper-server
COPY app.py .
COPY thai_corrections.json .
COPY thai_slang_words.json .
COPY drama_character_knowledge.json .
COPY self_register.py .
COPY entrypoint_dynamic.sh /usr/local/bin/entrypoint_dynamic.sh

RUN chmod +x /usr/local/bin/entrypoint_dynamic.sh && \
    ln -sf /usr/local/bin/entrypoint_dynamic.sh /usr/local/bin/entrypoint.sh && \
    ln -sf /usr/local/bin/entrypoint_dynamic.sh /usr/bin/entrypoint.sh && \
    ln -sf /usr/local/bin/entrypoint_dynamic.sh /entrypoint.sh

EXPOSE 10100 22

ENTRYPOINT ["/usr/local/bin/entrypoint_dynamic.sh"]
